(lang dune 3.13)
(using dune_site 0.1)
(name frama-c-arm8)

(generate_opam_files true)
(license BSD-3-Clause)
(maintainers "Vincent Lagerros")
(authors "Vincent Lagerros")
(source (github VincentLagerros/frama-c-arm8))
(homepage "https://github.com/VincentLagerros/frama-c-arm8")
(version dev)

(package
 (name frama-c-arm8)
 (depends
  (ocaml (>= 5.0))
  (frama-c (and (>= 33) (< 34))))
 (synopsis "Frama-C plugin for translating ACSL contracts to ARMv8 binary contracts")
 (description "This plugin for the Frama-C platform translates ACSL contracts
to ARMv8 binary contracts as defined by the HOL4 definition generated by L3.")
)
