[kernel] Parsing update_sat.c (with preprocessing)
(* -------------- *)
(* ARMv8 contract *)
(* -------------- *)

(* ------- Function update_sat -------*)
Definition arm8_update_sat_pre_def:
 arm8_update_sat_pre (pre_x0:word64) (pre_x1:word64) (pre_x2:word64) (pre_x3:word64) (st:arm8_state) : bool =
  ((((-(2147483647w : word64)) - (1w : word64)) < pre_x2) /\
  (pre_x2 < pre_x3) /\
  (pre_x2 <= pre_x1) /\
  (pre_x1 <= pre_x3) /\
  (pre_x3 < (2147483647w : word64)) /\
  (pre_x3 = (st.REG 3w)) /\
  (pre_x2 = (st.REG 2w)) /\
  (pre_x1 = (st.REG 1w)) /\
  (pre_x0 = (st.REG 0w)))
End

Definition arm8_update_sat_post_def:
 arm8_update_sat_post (pre_x0:word64) (pre_x1:word64) (pre_x2:word64) (pre_x3:word64) (st:arm8_state) : bool =
  (((pre_x0 = (0w : word64)) /\
  ((pre_x1 - (1w : word64)) < pre_x2) ==> ((st.REG 0w) = pre_x2)) /\
  ((pre_x0 = (0w : word64)) /\
  (pre_x2 <= (pre_x1 - (1w : word64))) ==> ((st.REG 0w) = (pre_x1 - (1w : word64)))) /\
  ((pre_x0 <> (0w : word64)) /\
  (pre_x3 < (pre_x1 + (1w : word64))) ==> ((st.REG 0w) = pre_x3)) /\
  ((pre_x0 <> (0w : word64)) /\
  ((pre_x1 + (1w : word64)) <= pre_x3) ==> ((st.REG 0w) = (pre_x1 + (1w : word64)))))
End


