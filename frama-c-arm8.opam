opam-version: "2.0"
version: "dev"
synopsis:
  "Frama-C plugin for translating ACSL contracts to ARMv8 binary contracts"
description: """
This plugin for the Frama-C platform translates ACSL contracts
to ARMv8 binary contracts as defined by the HOL4 definition generated by L3."""
maintainer: ["Vincent Lagerros"]
authors: ["Vincent Lagerros"]
license: "BSD-3-Clause"
homepage: "https://github.com/kth-step/frama-c-arm8"
bug-reports: "https://github.com/VincentLagerros/frama-c-arm8/issues"
depends: [
  "dune" {>= "3.13"}
  "ocaml" {>= "5.0"}
  "frama-c" {>= "33" & < "34"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "--promote-install-files=false"
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
  ["dune" "install" "-p" name "--create-install-files" name]
]
dev-repo: "git+https://github.com/VincentLagerros/frama-c-arm8.git"
